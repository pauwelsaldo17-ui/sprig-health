# Fake Supabase vars for E2E tests.
# Loaded by Vite only when running with --mode test (i.e. from playwright.config.js).
# These values are intentionally fake — they just need to be non-empty so
# supabaseConfigured() returns true, enabling the auth gate to be bypassed via
# the fake session seeded in localStorage by addInitScript in smoke.spec.js.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImV4cCI6OTk5OTk5OTk5OX0.fake
